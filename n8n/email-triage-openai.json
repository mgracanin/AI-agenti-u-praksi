    {
      "parameters": {
        "jsCode": "const confidence = Math.max(0, Math.min(1, Number($json.confidence || 0)));\nconst draft = String($json.draft || '').trim();\nconst shouldCreateDraft = $json.needs_reply === true && confidence >= 0.80 && draft.length > 0;\nconst calendarProposal = $json.has_calendar_item === true\n  ? { title: String($json.event_title || ''), start: String($json.event_start || ''), end: String($json.event_end || ''), timezone: String($json.event_timezone || 'Europe/Zagreb') }\n  : null;\n\nreturn {\n  json: {\n    ...$json,\n    confidence,\n    draft,\n    should_create_draft: shouldCreateDraft,\n    calendar_proposal: calendarProposal,\n    outcome: shouldCreateDraft ? 'SKICA' : 'SAZETAK',\n    processed_at: new Date().toISOString()\n  }\n};"
      },
