    {
      "parameters": {
        "jsCode": "const rows = Array.isArray($json.items) ? $json.items : [];\nconst date = new Intl.DateTimeFormat('hr-HR', { timeZone: 'Europe/Zagreb', dateStyle: 'full' }).format(new Date());\nconst lines = [`Jutarnji pregled pošte - ${date}`, '', `Obrađeno poruka: ${rows.length}`, ''];\nfor (const [index, row] of rows.entries()) {\n  lines.push(`${index + 1}. [${String(row.priority || 'normal').toUpperCase()}] ${row.subject || '(bez naslova)'}`);\n  lines.push(`   Od: ${row.sender_name || ''} <${row.sender_email || ''}>`);\n  lines.push(`   Ishod: ${row.outcome === 'SKICA' ? 'napravljena skica za provjeru' : 'samo sažetak'}`);\n  lines.push(`   Sažetak: ${row.summary || ''}`);\n  lines.push(`   Razlog: ${row.reason || ''} (pouzdanost ${Number(row.confidence || 0).toFixed(2)})`);\n  if (row.calendar_proposal) {\n    lines.push(`   Kalendar - prijedlog, nije automatski upisan: ${row.calendar_proposal.title || ''}; ${row.calendar_proposal.start || 'vrijeme nije pouzdano određeno'}; ${row.calendar_proposal.timezone || 'Europe/Zagreb'}`);\n  }\n  lines.push('');\n}\nreturn { json: { subject: `AI jutarnji pregled - ${date}`, body: lines.join('\\n') } };"
      },
