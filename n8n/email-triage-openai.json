    {
      "parameters": {
        "jsCode": "function extractAddress(value) {\n  if (!value) return { name: '', email: '' };\n  if (typeof value === 'object' && Array.isArray(value.value) && value.value[0]) {\n    return { name: value.value[0].name || '', email: value.value[0].address || '' };\n  }\n  const text = String(value.text || value);\n  const match = text.match(/^(.*?)\\s*<([^>]+)>$/);\n  return match ? { name: match[1].trim().replace(/^\\\"|\\\"$/g, ''), email: match[2].trim() } : { name: '', email: text.trim() };\n}\n\nfunction htmlToText(html) {\n  return String(html || '')\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n    .replace(/<br\\s*\\/?\\s*>/gi, '\\n')\n    .replace(/<\\/p>/gi, '\\n')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/&nbsp;/gi, ' ')\n    .replace(/&amp;/gi, '&')\n    .replace(/&lt;/gi, '<')\n    .replace(/&gt;/gi, '>');\n}\n\nconst sender = extractAddress($json.from);\nlet body = $json.text || $json.textPlain || htmlToText($json.html || $json.textHtml || '');\nbody = String(body)\n  .replace(/\\r/g, '')\n  .split(/\\n(?:On .+ wrote:|Dana .+ napisao je:|From:|Od:|-----Original Message-----)/i)[0]\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim()\n  .slice(0, 12000);\n\nreturn {\n  json: {\n    message_id: $json.id,\n    thread_id: $json.threadId,\n    sender_name: sender.name,\n    sender_email: sender.email,\n    subject: String($json.subject || '(bez naslova)').slice(0, 500),\n    received_at: $json.date || '',\n    body\n  }\n};"
      },
      "id": "c35ff67c-d3db-4440-857c-f7d4bb7a7bbe",
      "name": "Normaliziraj i skrati poruku",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
